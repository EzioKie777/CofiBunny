# Copy this file to .env and fill in your own values. Never commit .env.

# Get this from MongoDB Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <password> with your database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cofibunny?retryWrites=true&w=majority

# Any long random string. You can generate one with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string

PORT=4000
